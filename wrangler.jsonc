{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the deployed Worker. Cloudflare Workers Builds deploys this repo
  // as "uninav"; a mismatch here silently sends `npm run deploy` to a second,
  // empty Worker that has none of the production secrets bound to it.
  "name": "uninav",

  // The CLI is authenticated against four accounts. The deployed "uninav" Worker
  // lives in this one (Michaeloberteicher@gmail.com's Account) — NOT the
  // andreslopez account. Without this, every `wrangler secret put` aborts with
  // "More than one account available".
  "account_id": "0df6a139f9d0c5f70168e045d6da7b32",

  // The adapter supplies the Worker entrypoint; Astro's build wires the compiled
  // server bundle in behind it. Do not point this at a path inside dist/ — the
  // Cloudflare Vite plugin resolves `main` before the build has produced anything.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "compatibility_date": "2026-07-28",

  // nodejs_compat: required by the Stripe SDK (reaches for Node built-ins).
  //
  // assets_navigation_has_no_effect: disables Cloudflare's 2025-04-01 default
  // "navigation requests prefer asset serving". WITHOUT this flag, a real browser
  // navigation (Sec-Fetch-Mode: navigate) to a path with no matching static file
  // is answered by the asset layer's 404 page and the Worker never runs — which
  // silently broke every server route for browsers while curl kept working:
  //   • the purchase rail's `POST /api/checkout` returned 405 (assets reject POST)
  //   • Stripe's success_url `GET /thank-you` rendered "Page not found"
  //   • Stripe webhook POSTs would have been dropped the same way
  // The flag restores pre-2025 behavior: unmatched requests fall through to the
  // Worker (Astro SSR), which serves /thank-you, the API routes, and its own 404.
  // Static marketing pages still match real files and are served asset-first.
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Prerendered marketing pages are real files. Anything matching nothing
    // should render our designed 404 rather than a bare Worker error.
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true }

  // Secrets are NOT declared here — they are uploaded with `wrangler secret put`
  // (or set in the dashboard) and listed in .dev.vars.example. See README.md.
}
