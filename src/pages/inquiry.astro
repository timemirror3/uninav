---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.tsx';
import DraftFlag from '../components/DraftFlag.astro';
import { SITE } from '../lib/site';
import { breadcrumbs } from '../lib/jsonld';

export const prerender = true;

const turnstileSiteKey = import.meta.env['PUBLIC_TURNSTILE_SITE_KEY'] ?? '';

const jsonLd = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Request for Information', path: '/inquiry' },
  ]),
];
---

<Base
  title="Request for Information"
  description="Tell us about the student. We use this information only to prepare for your consultation and respond to your inquiry. It is never sold or shared."
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-[760px] px-5 py-12 sm:px-8 lg:px-12 lg:py-18">
    <div class="eyebrow eyebrow-lg mb-4">Request for Information</div>
    <h1 class="mb-4.5 font-serif text-[clamp(30px,6vw,44px)] text-maroon">
      Tell us about the student
    </h1>
    <p class="mb-2 text-[15px] leading-[1.65] text-ink-soft">
      We use this information only to prepare for your consultation and respond to your
      inquiry. It is never sold or shared. Most fields beyond your name and email are
      optional.
    </p>
    {/*
      The prototype recommends dropping street address at the inquiry stage in
      favour of city/state. The client chose to ship as designed, so the fields
      stay. Recorded in CONTENT-REVIEW.md.
    */}
    <p class="mb-9 text-[12px]">
      <DraftFlag
        type="recommendation"
        note="drop street address at inquiry stage — city/state suffices. Kept optional here pending your call."
      />
    </p>

    <InquiryForm
      client:load
      turnstileSiteKey={turnstileSiteKey}
      phone={SITE.phone}
      phoneHref={SITE.phoneHref}
    />
  </div>
</Base>
