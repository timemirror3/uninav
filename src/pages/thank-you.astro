---
import type Stripe from 'stripe';
import Base from '../layouts/Base.astro';
import DraftFlag from '../components/DraftFlag.astro';
import { getEnv } from '../lib/env';
import { stripeClient, formatAmount } from '../lib/stripe';
import { getProduct, rushResponseHours } from '../lib/products';
import { SITE } from '../lib/site';

export const prerender = false;

/**
 * Post-payment confirmation.
 *
 * The session is retrieved and verified server-side before anything is
 * confirmed. `session_id` in the query string is an unauthenticated input — on
 * its own it proves nothing, so it is never trusted to decide what this page
 * says.
 */
const env = getEnv(Astro);
const sessionId = Astro.url.searchParams.get('session_id');

let session: Stripe.Checkout.Session | null = null;
let verified = false;

if (sessionId && env.STRIPE_SECRET_KEY && sessionId.startsWith('cs_')) {
  try {
    const stripe = stripeClient(env.STRIPE_SECRET_KEY);
    session = await stripe.checkout.sessions.retrieve(sessionId);
    // Only a genuinely paid session counts. ACH sessions can land here while
    // still `unpaid`, so "processing" is treated as its own state below.
    verified = session.payment_status === 'paid' || session.status === 'complete';
  } catch (error) {
    console.error(
      '[thank-you] session lookup failed:',
      error instanceof Error ? error.message : 'unknown error'
    );
  }
}

const metadata = session?.metadata ?? {};
const product = getProduct(metadata['product_slug'] ?? '');
const isRush = metadata['is_rush'] === 'true' || product?.isRush === true;
const isPending = Boolean(session) && session?.payment_status === 'unpaid';
const responseHours = rushResponseHours(env);

const amount = session ? formatAmount(session.amount_total, session.currency ?? 'usd') : '';
const productName = product?.name ?? metadata['product_name'] ?? '';

/**
 * Rush gets a specific hour commitment rather than the generic one-business-day
 * line, because someone paid a premium for speed and is now waiting on an inbox.
 * The number comes from RUSH_RESPONSE_HOURS so it can change without a deploy.
 */
type Step = { before: string; link?: { href: string; text: string }; after?: string };

const nextSteps: Step[] = isRush
  ? [
      {
        before: `Because this is a rush request, the office will email you within ${responseHours} hours to schedule your consultation.`,
      },
      { before: 'Questions? Call ', link: { href: SITE.phoneHref, text: SITE.phone }, after: '.' },
    ]
  : [
      { before: "We'll email you within one business day to schedule your first session." },
      {
        before: 'Essay drafts can be emailed any time to ',
        link: { href: `mailto:${SITE.email}`, text: SITE.email },
        after: ' — 72-hour turnaround.',
      },
      { before: 'Questions? Call ', link: { href: SITE.phoneHref, text: SITE.phone }, after: '.' },
    ];
---

<Base
  title={verified ? 'Payment confirmed' : 'Order status'}
  description="Your engagement with University Navigator, Inc. is confirmed."
  noindex
>
  <div class="mx-auto max-w-[720px] px-5 py-16 text-center sm:px-8 lg:px-12 lg:py-24">
    {
      verified ? (
        <>
          <div class="mx-auto mb-6.5 flex h-16 w-16 items-center justify-center rounded-full bg-gold text-[28px] text-maroon-deep">
            ✓
          </div>
          <h1 class="mb-4 font-serif text-[clamp(30px,6vw,44px)] text-maroon">
            Payment confirmed
          </h1>
          <p class="mb-9 text-[16px] leading-[1.65] sm:text-[17px]">
            Thank you — your engagement with {SITE.name} is confirmed. A receipt and
            welcome email are on their way to your inbox.
          </p>

          {productName && (
            <div class="mx-auto mb-9 max-w-[420px] rounded-[6px] border border-rule bg-white px-6 py-5 text-left">
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-[15px] text-ink-soft">{productName}</span>
                <strong class="font-serif text-[20px] text-maroon">{amount}</strong>
              </div>
            </div>
          )}

          <div class="mb-9 rounded-[6px] border border-rule bg-white p-7 text-left">
            <h2 class="eyebrow mb-3.5 font-sans">What happens next</h2>
            <ol class="m-0 flex list-none flex-col gap-3 p-0 text-[15px] leading-[1.6]">
              {nextSteps.map((step, index) => (
                <li class="flex gap-3">
                  <span class="font-semibold text-gold">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span>
                    {step.before}
                    {step.link && <a href={step.link.href}>{step.link.text}</a>}
                    {step.after}
                  </span>
                </li>
              ))}
            </ol>
            <p class="mt-3.5 text-[11px]">
              <DraftFlag />
            </p>
          </div>

          <a href="/" class="link-rule text-[15px]">Back to home</a>
        </>
      ) : isPending ? (
        <>
          <h1 class="mb-4 font-serif text-[clamp(28px,6vw,40px)] text-maroon">
            Payment processing
          </h1>
          <p class="mx-auto mb-8 max-w-[52ch] text-[16px] leading-[1.65]">
            Your bank transfer has been initiated and can take a few business days to
            settle. We'll email you as soon as it clears. Nothing further is needed from
            you.
          </p>
          <a href="/" class="link-rule text-[15px]">Back to home</a>
        </>
      ) : (
        <>
          <h1 class="mb-4 font-serif text-[clamp(28px,6vw,40px)] text-maroon">
            We couldn't confirm this order
          </h1>
          <p class="mx-auto mb-8 max-w-[52ch] text-[16px] leading-[1.65]">
            This confirmation link isn't valid, or the payment didn't complete. If you
            believe you were charged, email
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call
            <a href={SITE.phoneHref}>{SITE.phone}</a> and we'll sort it out straight away.
          </p>
          <a href="/services" class="link-rule text-[15px]">Back to services</a>
        </>
      )
    }
  </div>
</Base>
