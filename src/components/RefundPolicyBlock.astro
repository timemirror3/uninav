---
import { REFUND_POLICY, SITE } from '../lib/site';

interface Props {
  /** 'lg' on /services, 'sm' in the service-detail sidebar column. */
  size?: 'lg' | 'sm';
  /** Render the "Full refund policy →" link (services index only). */
  showLink?: boolean;
  class?: string;
}

const { size = 'lg', showLink = false, class: className = '' } = Astro.props;
const textSize = size === 'lg' ? 'text-[17px]' : 'text-[15px]';
const gap = size === 'lg' ? 'gap-2' : 'gap-1.5';
---

<div class:list={[textSize, 'max-w-[68ch] leading-relaxed', className]}>
  <p class="mb-3.5">
    Refund requests must be submitted by email to <a href={`mailto:${SITE.email}`}
      >{SITE.email}</a
    > and are subject to the following terms:
  </p>
  <ul class:list={['mb-3.5 flex flex-col pl-[22px]', gap]}>
    {REFUND_POLICY.terms.map((term) => <li>{term}</li>)}
  </ul>
  {
    showLink && (
      <a href="/policies/refunds" class="text-[14px] font-semibold">
        Full refund policy →
      </a>
    )
  }
</div>
