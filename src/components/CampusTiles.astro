---
import { Picture } from 'astro:assets';
import berkeley from '../assets/campus-berkeley-campanile.webp';
import usc from '../assets/campus-usc-doheny.webp';
import harvard from '../assets/campus-harvard-widener.webp';
import mit from '../assets/campus-mit-dome.webp';
import { CAMPUS_DISCLAIMER } from '../lib/site';

/**
 * The four campus tiles. Captions and the disclaimer line are the prototype's,
 * verbatim — the disclaimer is not decorative, it disclaims affiliation.
 *
 * Alt text is descriptive of the building rather than repeating the caption,
 * so screen-reader users are not read the same string twice.
 */
const TILES = [
  {
    src: berkeley,
    caption: 'The Campanile — UC Berkeley',
    alt: 'The Campanile bell tower at UC Berkeley against an open sky.',
  },
  {
    src: usc,
    caption: 'Doheny Memorial Library — USC',
    alt: 'The Romanesque facade of Doheny Memorial Library at USC.',
  },
  {
    src: harvard,
    caption: 'Widener Library — Harvard',
    alt: 'The colonnaded steps of Widener Library at Harvard.',
  },
  {
    src: mit,
    caption: 'The Great Dome — MIT',
    alt: 'The Great Dome above the columns of MIT’s Killian Court.',
  },
];
---

<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  {
    TILES.map((tile) => (
      <figure class="m-0 flex flex-col gap-2">
        {/* Sources are already webp. The default png fallback emitted files ~7x
            larger than the originals, so the fallback is webp instead. */}
        <Picture
          src={tile.src}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[330, 660]}
          sizes="(min-width: 1024px) 285px, (min-width: 640px) 45vw, 44vw"
          alt={tile.alt}
          loading="lazy"
          decoding="async"
          class="h-[160px] w-full rounded-[6px] object-cover lg:h-[220px]"
        />
        <figcaption class="text-[12px] text-ink-muted">{tile.caption}</figcaption>
      </figure>
    ))
  }
</div>

<p class="mt-3 text-[12px] text-ink-muted">{CAMPUS_DISCLAIMER}</p>
