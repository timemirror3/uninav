# ---------------------------------------------------------------------------
# Build-time PUBLIC values. Committed on purpose.
#
# PUBLIC_* variables are inlined into the HTML at BUILD time, so they must exist
# wherever the build runs — including Cloudflare Workers Builds, which clones
# this repo and never sees the git-ignored .dev.vars. Leaving them out does not
# fail loudly: the cal.com embed silently renders its fallback and every form
# silently 403s. That is exactly what shipped.
#
# Nothing here is secret. These values are visible in the page source by design;
# a Turnstile SITE key is public, only the SECRET key is not. Real secrets stay
# in .dev.vars locally and `wrangler secret put` in production.
# ---------------------------------------------------------------------------

PUBLIC_CAL_LINK="university-navigator-lb9xx8/30min"

# Set this to the site key from your real Turnstile widget, then rebuild.
# Until it is set, the build refuses to complete — see scripts/preflight.mjs.
PUBLIC_TURNSTILE_SITE_KEY=""
